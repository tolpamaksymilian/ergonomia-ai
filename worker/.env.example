# ============================================================
# ERGONOMIA AI — WORKER V3.0
# ============================================================

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY

ANALYSIS_BUCKET=analysis-videos
ANALYSIS_RESULTS_BUCKET=analysis-results

WORKER_ID=local-worker-01
# Osobny identyfikator procesu CPU obliczającego metryki.
ERGONOMICS_WORKER_ID=local-ergonomics-worker-01
# Osobny identyfikator lekkiego procesu CPU uruchamiającego Risk Engine.
RISK_WORKER_ID=local-risk-worker-01
# Jawny profil jest wymagany. Repozytorium nie dostarcza profilu produkcyjnego.
RISK_PROFILE_PATH=profiles/risk-profile.json
WORKER_POLL_INTERVAL_SECONDS=10
WORKER_LOG_LEVEL=INFO
KEEP_WORKER_FILES=false

FFMPEG_PATH=

# ============================================================
# CIAŁO — COCO YOLOX-X + RTMW PERFORMANCE
# ============================================================

POSE_MODEL_MODE=performance

POSE_DETECTOR_SCORE_THRESHOLD=0.70
POSE_DETECTOR_NMS_THRESHOLD=0.45
POSE_DETECTOR_MIN_HEIGHT_RATIO=0.16
POSE_DETECTOR_MIN_AREA_RATIO=0.010
POSE_DETECTOR_MIN_ASPECT_RATIO=0.12
POSE_DETECTOR_MAX_ASPECT_RATIO=1.60
POSE_DETECTOR_MAX_PEOPLE=2

POSE_KEYPOINT_THRESHOLD=0.78
POSE_BODY_PRESENCE_THRESHOLD=0.80
POSE_BODY_MIN_KEYPOINTS=7

POSE_SCAN_FPS=5
POSE_SCAN_MIN_QUALITY=0.72
POSE_SCAN_START_CONFIRM_SECONDS=0.40
POSE_SCAN_END_CONFIRM_SECONDS=0.45

POSE_ACTIVE_PRE_PADDING_SECONDS=0.25
POSE_ACTIVE_POST_PADDING_SECONDS=0.25
POSE_MIN_ACTIVE_SECONDS=0.80
POSE_MIN_PRESENCE_RATIO=0.65

POSE_TRACK_MIN_IOU=0.015
POSE_TRACK_MAX_CENTER_JUMP_RATIO=0.30
POSE_MAX_TRACK_GAP_FRAMES=9

POSE_ONE_EURO_MIN_CUTOFF=1.0
POSE_ONE_EURO_BETA=0.035
POSE_ONE_EURO_D_CUTOFF=1.0

# ============================================================
# DŁONIE — MEDIAPIPE HAND LANDMARKER + WALIDACJA OFFLINE
# ============================================================

# Ścieżka jest liczona względem katalogu worker/.
# Model pobierze się automatycznie przy pierwszym uruchomieniu.
POSE_HAND_MODEL_PATH=models/hand_landmarker.task

POSE_HAND_DETECTION_CONFIDENCE=0.65
POSE_HAND_PRESENCE_CONFIDENCE=0.65
POSE_HAND_TRACKING_CONFIDENCE=0.65

POSE_HAND_ASSIGNMENT_MAX_WRIST_DISTANCE_RATIO=1.05
POSE_HAND_HANDEDNESS_SOFT_PENALTY=0.18
POSE_HAND_MIN_PALM_SIZE_PIXELS=8.0
POSE_HAND_MIN_FOREARM_PIXELS=12.0

# Dłoń musi być poprawna przez minimum 2 kolejne klatki,
# zanim linie palców zostaną pokazane.
POSE_HAND_MIN_LOCK_FRAMES=2

# Interpolujemy najwyżej jedną brakującą klatkę.
POSE_HAND_MAX_INTERPOLATION_GAP_FRAMES=1

POSE_HAND_MAX_ROOT_WRIST_DISTANCE_RATIO=0.75
POSE_HAND_MIN_SCALE_RATIO=0.50
POSE_HAND_MAX_SCALE_RATIO=1.90
POSE_HAND_MAX_SCALE_CHANGE_RATIO=0.48
POSE_HAND_MAX_ORIENTATION_CHANGE_DEGREES=105.0

# Nienaturalny skok punktu lub całej dłoni powoduje ukrycie palców.
POSE_HAND_MAX_JOINT_VELOCITY_PALM_RATIO=1.35
POSE_HAND_MAX_MEDIAN_JOINT_VELOCITY_PALM_RATIO=0.70
POSE_HAND_MAX_WORLD_DEPTH_JUMP_METERS=0.11

# Kontrola długości kości palców względem mediany z całego fragmentu.
POSE_HAND_BONE_LOG_TOLERANCE=0.52
POSE_HAND_MAX_BONE_OUTLIERS=3
POSE_HAND_MAX_RADIUS_FOREARM_RATIO=1.55
POSE_HAND_MAX_BONE_FOREARM_RATIO=0.68

# Dwukierunkowe wygładzanie offline bez typowego opóźnienia live.
POSE_HAND_MEDIAN_WINDOW=3
POSE_HAND_SMOOTHING_ALPHA=0.62
POSE_HAND_BONE_PROJECTION_STRENGTH=0.42

POSE_DRAW_HANDS=true
POSE_DRAW_FACE=false
POSE_PROGRESS_UPDATE_INTERVAL_FRAMES=15
POSE_OUTPUT_CRF=22
